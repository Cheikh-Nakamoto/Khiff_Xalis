# BRVM Trading Engine - Environment Variables Template
# Copy to .env and fill in real values

# Database
POSTGRES_USER=brvm
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=brvm_trading
DATABASE_URL=postgres://brvm:your_strong_password_here@postgres:5432/brvm_trading

# Redis
REDIS_URL=redis:6379

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_here

# API
PORT=8080
CORS_ORIGINS=http://localhost:3000,https://brvm-app.web.app

# Grafana
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password

# MinIO
MINIO_ROOT_USER=brvm_minio
MINIO_ROOT_PASSWORD=your_minio_password

# External APIs
GITHUB_CSV_URL=https://raw.githubusercontent.com/Fredysessie/brvm-data-public/main/data
SIKAFINANCE_URL=https://www.sikafinance.com/marches/download
FLUXBOURSE_URL=https://fluxbourse.com

# Notifications (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=
